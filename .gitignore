# ==========================
# Godot Engine - .gitignore
# ==========================

# Godot 4+ auto-generated files (engine cache, imported assets, etc.)
.godot/

# ==========================
# Android Build Files
# ==========================

# Android build directory (generated by Godot export)
/android/build/

# APK files (exported builds - don't commit binaries)
*.apk
*.aab

# ==========================
# Export & Build Artifacts
# ==========================

# Export credentials (contains sensitive signing info)
.godot/export_credentials.cfg

# Desktop/PC exports
*.exe
*.x86_64
*.x86
*.arm64

# Linux exports
*.elf

# macOS exports
*.dmg
*.app

# Web exports
*.html
*.wasm
*.js
*.pck
export_presets.cfg

# ==========================
# OS & Editor Junk
# ==========================

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# VS Code / JetBrains / other editors
.vscode/
.idea/
*.suo
*.user

# ==========================
# Logs & Temp Files
# ==========================

*.log
*.tmp
*.bak
*.swp

# ==========================
# Sensitive / Private
# ==========================

# Keystore files (Android signing keys - NEVER commit these)
*.keystore
*.jks
